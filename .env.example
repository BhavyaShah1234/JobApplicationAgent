# Copy to .env (scripts/setup_env.sh does this and generates VAULT_KEY).
# OPENAI_API_KEY is NOT stored here: docker compose passes it through from your host shell (~/.bashrc).

# Voyager (ASU Research Computing) — OpenAI-compatible endpoint
OPENAI_BASE_URL=https://openai.rc.asu.edu/v1

# Local Ollama fallback (host networking → localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Model roles — Voyager primary (see GET /v1/models) / Ollama fallback
MODEL_PLANNER=qwen35-397b-a17b
MODEL_VISION=qwen38-27b
MODEL_FAST=qwen3-30b-a3b
MODEL_EMBED=qwen3-embedding-8b
FALLBACK_PLANNER=qwen3:4b
FALLBACK_VISION=qwen2.5vl:3b
FALLBACK_FAST=qwen3:4b
FALLBACK_EMBED=nomic-embed-text

# Fernet key for state/vault.enc. Losing it makes the vault unreadable; changing it requires re-entering credentials.
VAULT_KEY=

# Browser
CHROME_CHANNEL=chrome
HEADLESS=false
TZ=America/Phoenix
